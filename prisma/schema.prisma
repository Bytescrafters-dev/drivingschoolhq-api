// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// PLATFORM DOMAIN — platform administration
// =============================================================================

/// Fixed platform roles. Role → permission mapping lives in application code;
/// authorization checks must be permission-based, never role-name based.
enum PlatformRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  BILLING_ADMIN
  SUPPORT
}

enum PlatformAdminStatus {
  ACTIVE
  DISABLED
}

/// Operator of the SaaS platform. Not tenant-owned and independent from
/// TenantUser / tenant RBAC. Admins are never hard-deleted; they are DISABLED
/// so that historical references (payments recorded, audit logs) stay valid.
model PlatformAdminUser {
  id                 String              @id @default(uuid()) @db.Uuid
  /// Normalised (trimmed, lowercased) by the application before persisting.
  email              String              @unique
  fullName           String
  passwordHash       String
  role               PlatformRole
  status             PlatformAdminStatus @default(ACTIVE)
  /// True while the admin holds a temporary password set by a super admin.
  mustChangePassword Boolean             @default(true)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  disabledAt         DateTime?

  /// Null only for the seeded bootstrap super admin.
  createdById   String?             @db.Uuid
  createdBy     PlatformAdminUser?  @relation("PlatformAdminCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAdmins PlatformAdminUser[] @relation("PlatformAdminCreatedBy")

  sessions        PlatformAdminSession[]
  auditLogEntries PlatformAuditLog[]

  createdPricePlans      PricePlan[]
  createdTenants         Tenant[]
  createdSubscriptions   TenantSubscription[] @relation("TenantSubscriptionCreatedBy")
  cancelledSubscriptions TenantSubscription[] @relation("TenantSubscriptionCancelledBy")
  createdTenantUsers     TenantUser[]
  createdBranches        Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
  @@index([createdById])
  @@map("platform_admin_users")
}

enum PlatformSessionRevokedReason {
  LOGOUT
  ROTATED
  PASSWORD_CHANGED
  PASSWORD_RESET
  ROLE_CHANGED
  ADMIN_DISABLED
  REFRESH_TOKEN_REUSE
}

/// One login session of a platform admin. Holds the hash of the current
/// refresh token; each refresh rotates to a new session row.
model PlatformAdminSession {
  id               String                        @id @default(uuid()) @db.Uuid
  adminId          String                        @db.Uuid
  admin            PlatformAdminUser             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the opaque refresh token. The raw token is never stored.
  refreshTokenHash String                        @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    PlatformSessionRevokedReason?
  /// Session that replaced this one on refresh-token rotation.
  replacedById     String?                       @db.Uuid
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime                      @default(now())

  @@index([adminId, revokedAt])
  @@map("platform_admin_sessions")
}

/// Append-only record of who did what on the platform. Rows are never
/// updated or deleted (enforced by a database trigger).
model PlatformAuditLog {
  id           String             @id @default(uuid()) @db.Uuid
  /// Null when there is no authenticated actor (e.g. failed login).
  actorAdminId String?            @db.Uuid
  actorAdmin   PlatformAdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  /// Code-defined PlatformAuditAction value.
  action       String
  targetType   String?
  targetId     String?
  /// Tenant the action concerns (required for TENANT, TENANT_SUBSCRIPTION and
  /// TENANT_USER targets; enforced by a CHECK). Lets admins filter by tenant.
  tenantId     String?            @db.Uuid
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Changed fields / context only. Never secrets or password material.
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime           @default(now())

  @@index([createdAt])
  @@index([actorAdminId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

// =============================================================================
// PLATFORM DOMAIN — plan catalogue
// =============================================================================

enum PricePlanStatus {
  /// Being configured; cannot be selected for new subscriptions.
  DRAFT
  /// Selectable for new subscriptions.
  ACTIVE
  /// No longer offered. Existing subscriptions keep working from their snapshot.
  ARCHIVED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PlanPriceStatus {
  ACTIVE
  ARCHIVED
}

/// Quantitative limits. Enforcement lives in a plan-access service, never in
/// plan-name conditionals.
enum PlanLimitCode {
  MAX_STAFF_USERS
  MAX_BRANCHES
  MAX_INSTRUCTORS
  MAX_VEHICLES
}

/// Feature entitlements (on/off).
enum PlanFeatureCode {
  SMS_NOTIFICATIONS
  ADVANCED_REPORTING
  API_ACCESS
}

/// Commercial product in the SaaS catalogue (e.g. STARTER, PROFESSIONAL).
/// Never hard-deleted: archive instead, subscriptions keep referencing it.
model PricePlan {
  id          String          @id @default(uuid()) @db.Uuid
  /// Normalised (trimmed, uppercased) by the application before persisting.
  code        String          @unique
  name        String
  description String?
  status      PricePlanStatus @default(DRAFT)
  /// False for private/custom-deal plans that are not listed publicly.
  isPublic    Boolean         @default(true)
  sortOrder   Int             @default(0)
  archivedAt  DateTime?

  createdById String            @db.Uuid
  createdBy   PlatformAdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)

  prices        PlanPrice[]
  limits        PlanLimit[]
  features      PlanFeature[]
  subscriptions TenantSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@map("price_plans")
}

/// Price of a plan for one billing period. Immutable once created: a price
/// change archives the old row and creates a new one. At most one ACTIVE price
/// per (plan, billing period) — enforced by a partial unique index.
/// All amounts on the platform are LKR.
model PlanPrice {
  id            String          @id @default(uuid()) @db.Uuid
  planId        String          @db.Uuid
  plan          PricePlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingPeriod BillingPeriod
  amount        Decimal         @db.Decimal(12, 2)
  status        PlanPriceStatus @default(ACTIVE)
  archivedAt    DateTime?

  subscriptions TenantSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, id])
  @@index([planId, status])
  @@map("plan_prices")
}

/// Numeric limit of a plan. `value = null` means unlimited.
model PlanLimit {
  id     String        @id @default(uuid()) @db.Uuid
  planId String        @db.Uuid
  plan   PricePlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  code   PlanLimitCode
  value  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, code])
  @@map("plan_limits")
}

/// Feature included in a plan. Presence of the row grants the feature.
model PlanFeature {
  id     String          @id @default(uuid()) @db.Uuid
  planId String          @db.Uuid
  plan   PricePlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  code   PlanFeatureCode

  createdAt DateTime @default(now())

  @@unique([planId, code])
  @@map("plan_features")
}

// =============================================================================
// PLATFORM DOMAIN — tenants and subscriptions
// =============================================================================

/// The 25 administrative districts of Sri Lanka.
enum District {
  AMPARA
  ANURADHAPURA
  BADULLA
  BATTICALOA
  COLOMBO
  GALLE
  GAMPAHA
  HAMBANTOTA
  JAFFNA
  KALUTARA
  KANDY
  KEGALLE
  KILINOCHCHI
  KURUNEGALA
  MANNAR
  MATALE
  MATARA
  MONARAGALA
  MULLAITIVU
  NUWARA_ELIYA
  POLONNARUWA
  PUTTALAM
  RATNAPURA
  TRINCOMALEE
  VAVUNIYA
}

/// Lifecycle of the tenant on the platform. Billing-driven access is tracked
/// separately in TenantAccess.
enum TenantStatus {
  ACTIVE
  CLOSED
}

/// One driving school using the SaaS. Never hard-deleted: CLOSED instead.
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  /// Government-issued driving school code: "DS" + digits (e.g. DS119),
  /// uppercased. Format enforced by a DB CHECK.
  /// Also the tenant identifier used at tenant-user login.
  dsCode      String       @unique
  /// Legal / registered name.
  name        String
  displayName String
  address     String
  district    District
  /// Normalised to +94XXXXXXXXX by the application.
  phone       String
  status      TenantStatus @default(ACTIVE)
  closedAt    DateTime?

  createdById String            @db.Uuid
  createdBy   PlatformAdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)

  subscriptions     TenantSubscription[]
  access            TenantAccess?
  users             TenantUser[]
  userSessions      TenantUserSession[]
  auditLogs         TenantAuditLog[]
  platformAuditLogs PlatformAuditLog[]
  branches          Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([district])
  @@map("tenants")
}

enum TenantSubscriptionStatus {
  /// Plan change waiting for the current period to end.
  SCHEDULED
  /// The tenant's current subscription.
  ACTIVE
  /// Replaced by a scheduled change or ended at period end.
  ENDED
  /// Cancelled (a scheduled change withdrawn, or the subscription terminated).
  CANCELLED
}

/// Binding of a tenant to a plan price. Rows are history and are never
/// overwritten: a plan change ends the current row and activates a new one.
/// Commercial terms are snapshotted so catalogue changes never alter them.
/// At most one ACTIVE and one SCHEDULED row per tenant (partial unique indexes).
model TenantSubscription {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  planId      String    @db.Uuid
  plan        PricePlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPriceId String    @db.Uuid
  /// Composite FK guarantees the price belongs to the plan.
  planPrice   PlanPrice @relation(fields: [planId, planPriceId], references: [planId, id], onDelete: Restrict)

  // --- snapshot of agreed commercial terms ---
  planCode        String
  planName        String
  billingPeriod   BillingPeriod
  /// Catalogue price (LKR) at the time of subscribing.
  listAmount      Decimal       @db.Decimal(12, 2)
  /// Price the tenant actually pays per period (may be discounted).
  agreedAmount    Decimal       @db.Decimal(12, 2)
  /// Required whenever agreedAmount differs from listAmount.
  discountReason  String?
  gracePeriodDays Int

  status TenantSubscriptionStatus

  /// First day of the subscription.
  startDate    DateTime  @db.Date
  /// Last day of the free trial; null when there is no trial. Billing is
  /// anchored on trialEndDate when present, otherwise on startDate.
  trialEndDate DateTime? @db.Date
  /// Last day of the subscription; set when it is ENDED.
  endDate      DateTime? @db.Date

  cancelledAt        DateTime?
  cancelledById      String?            @db.Uuid
  cancelledBy        PlatformAdminUser? @relation("TenantSubscriptionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancellationReason String?

  createdById String            @db.Uuid
  createdBy   PlatformAdminUser @relation("TenantSubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, startDate])
  @@index([planId, planPriceId])
  @@map("tenant_subscriptions")
}

enum TenantAccessStatus {
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
}

/// Whether the tenant may use the SaaS. Separate from TenantUser.status:
/// suspending a tenant never disables its users.
model TenantAccess {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @unique @db.Uuid
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  status          TenantAccessStatus @default(ACTIVE)
  statusChangedAt DateTime           @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_access")
}

// =============================================================================
// DRIVING-SCHOOL DOMAIN — tenant users
// =============================================================================

/// Fixed tenant roles. Role → permission mapping lives in application code.
/// Exactly one OWNER per tenant (partial unique index); the OWNER is managed
/// only by platform admins.
enum TenantRole {
  OWNER
  ADMIN
  BRANCH_MANAGER
  FRONT_DESK
  INSTRUCTOR
  ACCOUNTANT
}

enum TenantUserStatus {
  ACTIVE
  DISABLED
}

/// Authenticated user of a driving school. Independent from PlatformAdminUser.
/// Never hard-deleted: DISABLED instead.
model TenantUser {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Normalised (trimmed, lowercased). Unique within the tenant.
  email              String
  fullName           String
  /// Normalised to +94XXXXXXXXX. Required for the OWNER at the API boundary.
  phone              String?
  /// Sri Lankan NIC, uppercased (old: 9 digits + V/X, new: 12 digits).
  /// Unique within the tenant. Required for the OWNER at the API boundary.
  nic                String?
  passwordHash       String
  role               TenantRole
  status             TenantUserStatus @default(ACTIVE)
  /// True while the user holds a temporary password.
  mustChangePassword Boolean          @default(true)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  disabledAt         DateTime?

  /// ALL = every active branch of the tenant (including future ones);
  /// SELECTED = only the branches in TenantUserBranch. The OWNER is always ALL
  /// (DB CHECK).
  branchAccess    TenantUserBranchAccess @default(SELECTED)
  /// Branch the user works in after login. Composite FK keeps it in the same
  /// tenant; for SELECTED users it is one of their assigned branches.
  defaultBranchId String                 @db.Uuid
  defaultBranch   Branch                 @relation("TenantUserDefaultBranch", fields: [tenantId, defaultBranchId], references: [tenantId, id], onDelete: Restrict)

  /// Exactly one creator is set: a platform admin (e.g. the OWNER) or a
  /// tenant user of the same tenant (staff).
  createdByPlatformAdminId String?            @db.Uuid
  createdByPlatformAdmin   PlatformAdminUser? @relation(fields: [createdByPlatformAdminId], references: [id], onDelete: Restrict)
  createdByTenantUserId    String?            @db.Uuid
  /// Composite FK guarantees the creating user belongs to the same tenant.
  createdByTenantUser      TenantUser?        @relation("TenantUserCreatedBy", fields: [tenantId, createdByTenantUserId], references: [tenantId, id], onDelete: Restrict)
  createdTenantUsers       TenantUser[]       @relation("TenantUserCreatedBy")

  sessions                   TenantUserSession[]
  auditLogEntries            TenantAuditLog[]
  branchAssignments          TenantUserBranch[]
  createdBranches            Branch[]              @relation("BranchCreatedBy")
  recordedBranchLicences     BranchSchoolLicence[] @relation("BranchLicenceRecordedBy")
  instructorProfile          InstructorProfile?    @relation("InstructorProfileUser")
  createdInstructorProfiles  InstructorProfile[]   @relation("InstructorProfileCreatedBy")
  recordedInstructorLicences InstructorLicence[]   @relation("InstructorLicenceRecordedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, nic])
  @@index([tenantId, role, status])
  @@index([createdByPlatformAdminId])
  @@index([tenantId, defaultBranchId])
  @@map("tenant_users")
}

enum TenantUserBranchAccess {
  ALL
  SELECTED
}

// =============================================================================
// REFERENCE DATA — vehicle classes and driving-school grades (global, seeded
// by migration, read-only through the API)
// =============================================================================

/// Grade of a driving-school licence; decides which vehicle classes a branch
/// may teach (see DrivingSchoolGradeVehicleClass).
enum DrivingSchoolGrade {
  A
  B
  C
}

/// A DMT licence vehicle class (A1, A, B1, B, C1, C, CE, D1, D, DE, G1, G, J).
model VehicleClass {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  name        String
  description String
  sortOrder   Int    @unique

  permittedForGrades       DrivingSchoolGradeVehicleClass[]
  branchOfferings          BranchVehicleClass[]
  instructorQualifications InstructorVehicleClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_classes")
}

/// Which vehicle classes each driving-school grade may teach. Data, not code:
/// a regulation change is a migration.
model DrivingSchoolGradeVehicleClass {
  grade          DrivingSchoolGrade
  vehicleClassId String             @db.Uuid
  vehicleClass   VehicleClass       @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)

  @@id([grade, vehicleClassId])
  @@index([vehicleClassId])
  @@map("driving_school_grade_vehicle_classes")
}

// =============================================================================
// DRIVING-SCHOOL DOMAIN — branches
// =============================================================================

enum BranchStatus {
  ACTIVE
  CLOSED
}

/// A physical branch of a driving school. Every tenant has at least one
/// ACTIVE branch ("Main Branch" is created with the tenant). Branch-scoped
/// records reference branches with a composite (tenantId, branchId) FK.
/// Never hard-deleted: CLOSED instead. Names are unique per tenant,
/// case-insensitively (hand-written unique index).
model Branch {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name     String
  address  String
  district District
  /// Normalised to +94XXXXXXXXX by the application.
  phone    String
  status   BranchStatus @default(ACTIVE)
  closedAt DateTime?

  /// Exactly one creator: a platform admin (the Main Branch) or a tenant user.
  createdByPlatformAdminId String?            @db.Uuid
  createdByPlatformAdmin   PlatformAdminUser? @relation(fields: [createdByPlatformAdminId], references: [id], onDelete: Restrict)
  createdByTenantUserId    String?            @db.Uuid
  createdByTenantUser      TenantUser?        @relation("BranchCreatedBy", fields: [tenantId, createdByTenantUserId], references: [tenantId, id], onDelete: Restrict)

  /// The branch's current driving-school licence (null until the profile is
  /// completed). The composite FK guarantees it is one of this branch's own
  /// licences. Older licences remain as history.
  currentLicenceId String?              @unique @db.Uuid
  currentLicence   BranchSchoolLicence? @relation("BranchCurrentLicence", fields: [tenantId, id, currentLicenceId], references: [tenantId, branchId, id], onDelete: Restrict)

  assignments     TenantUserBranch[]
  defaultForUsers TenantUser[]          @relation("TenantUserDefaultBranch")
  auditLogs       TenantAuditLog[]
  licences        BranchSchoolLicence[] @relation("BranchLicences")
  offeredClasses  BranchVehicleClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("branches")
}

/// The driving-school licence of a branch, stating its grade. Data entry
/// only: validity is the school's responsibility (nothing is blocked by
/// expiry). A renewal adds a new row; corrections edit the current row.
model BranchSchoolLicence {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  branchId      String             @db.Uuid
  branch        Branch             @relation("BranchLicences", fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  /// Not unique: kept as entered by the school.
  licenceNumber String
  grade         DrivingSchoolGrade
  issuedOn      DateTime           @db.Date
  expiresOn     DateTime           @db.Date

  recordedByTenantUserId String     @db.Uuid
  recordedBy             TenantUser @relation("BranchLicenceRecordedBy", fields: [tenantId, recordedByTenantUserId], references: [tenantId, id], onDelete: Restrict)

  currentForBranches Branch[] @relation("BranchCurrentLicence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, recordedByTenantUserId])
  @@map("branch_school_licences")
}

/// Vehicle classes a branch currently offers: always a subset of those its
/// current licence grade permits (enforced by the application under the
/// branch lock). Operational records reference VehicleClass, never this
/// table, so removing an offering never affects ongoing work.
model BranchVehicleClass {
  tenantId       String       @db.Uuid
  branchId       String       @db.Uuid
  branch         Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  vehicleClassId String       @db.Uuid
  vehicleClass   VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([branchId, vehicleClassId])
  @@index([tenantId, branchId])
  @@index([vehicleClassId])
  @@map("branch_vehicle_classes")
}

// =============================================================================
// DRIVING-SCHOOL DOMAIN — instructors
// =============================================================================

enum InstructorProfileStatus {
  ACTIVE
  INACTIVE
}

/// A staff member who teaches. Any role may hold one (the INSTRUCTOR role is
/// only the login role of people with no other duties). Tenant-scoped: the
/// person teaches in every branch their staff access covers. ACTIVE profiles
/// count towards MAX_INSTRUCTORS; staff status never changes this row, so a
/// disabled staff member keeps their seat until the profile is inactivated.
/// Never deleted: training history will reference it.
model InstructorProfile {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @db.Uuid
  tenantUserId  String                  @db.Uuid
  tenantUser    TenantUser              @relation("InstructorProfileUser", fields: [tenantId, tenantUserId], references: [tenantId, id], onDelete: Restrict)
  status        InstructorProfileStatus @default(ACTIVE)
  inactivatedAt DateTime?

  /// The current instructor licence. The composite FK guarantees it is one of
  /// this profile's own licences; older licences remain as history. Set in
  /// the same transaction that creates the profile.
  currentLicenceId String?            @unique @db.Uuid
  currentLicence   InstructorLicence? @relation("InstructorCurrentLicence", fields: [tenantId, id, currentLicenceId], references: [tenantId, instructorProfileId, id], onDelete: Restrict)

  createdByTenantUserId String     @db.Uuid
  createdBy             TenantUser @relation("InstructorProfileCreatedBy", fields: [tenantId, createdByTenantUserId], references: [tenantId, id], onDelete: Restrict)

  licences         InstructorLicence[]      @relation("InstructorLicences")
  qualifiedClasses InstructorVehicleClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, tenantUserId])
  @@index([tenantId, status])
  @@index([tenantId, createdByTenantUserId])
  @@map("instructor_profiles")
}

/// An instructor licence, stating its grade (same grade matrix as driving
/// schools). Data entry only: expiry never blocks anything. A renewal adds a
/// new row; corrections edit the current row.
model InstructorLicence {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  instructorProfileId String             @db.Uuid
  instructorProfile   InstructorProfile  @relation("InstructorLicences", fields: [tenantId, instructorProfileId], references: [tenantId, id], onDelete: Restrict)
  /// Not unique: kept as entered by the school.
  licenceNumber       String
  grade               DrivingSchoolGrade
  issuedOn            DateTime           @db.Date
  expiresOn           DateTime           @db.Date

  recordedByTenantUserId String     @db.Uuid
  recordedBy             TenantUser @relation("InstructorLicenceRecordedBy", fields: [tenantId, recordedByTenantUserId], references: [tenantId, id], onDelete: Restrict)

  currentForProfiles InstructorProfile[] @relation("InstructorCurrentLicence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, instructorProfileId, id])
  @@index([tenantId, instructorProfileId, createdAt])
  @@index([tenantId, recordedByTenantUserId])
  @@map("instructor_licences")
}

/// Vehicle classes an instructor is qualified to teach: a subset of those
/// their current licence grade permits, independent of any branch. What they
/// teach at a branch is this set intersected with the branch's offerings.
model InstructorVehicleClass {
  tenantId            String            @db.Uuid
  instructorProfileId String            @db.Uuid
  instructorProfile   InstructorProfile @relation(fields: [tenantId, instructorProfileId], references: [tenantId, id], onDelete: Restrict)
  vehicleClassId      String            @db.Uuid
  vehicleClass        VehicleClass      @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([instructorProfileId, vehicleClassId])
  @@index([tenantId, instructorProfileId])
  @@index([vehicleClassId])
  @@map("instructor_vehicle_classes")
}

/// Branches a SELECTED-access tenant user may work in. Composite FKs make an
/// assignment across tenants impossible.
model TenantUserBranch {
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  user     TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branchId String     @db.Uuid
  branch   Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([tenantId, branchId])
  @@map("tenant_user_branches")
}

enum TenantSessionRevokedReason {
  LOGOUT
  ROTATED
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_DISABLED
  EMAIL_CHANGED
  TENANT_CLOSED
  REFRESH_TOKEN_REUSE
  /// The user's last ACTIVE branch was closed (SELECTED access).
  NO_ACTIVE_BRANCH
}

/// One login session of a tenant user. Holds the hash of the current refresh
/// token; each refresh rotates to a new session row.
model TenantUserSession {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId   String     @db.Uuid
  /// Composite FK guarantees the session's user belongs to the same tenant.
  user     TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  /// SHA-256 hex of the opaque refresh token. The raw token is never stored.
  refreshTokenHash String                      @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    TenantSessionRevokedReason?
  /// Session that replaced this one on refresh-token rotation.
  replacedById     String?                     @db.Uuid
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime                    @default(now())

  @@index([userId, revokedAt])
  @@index([tenantId, revokedAt])
  @@map("tenant_user_sessions")
}

/// Append-only operational audit of a tenant: who did what inside the driving
/// school. Separate from PlatformAuditLog. Rows are never updated or deleted
/// (enforced by a database trigger).
model TenantAuditLog {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @db.Uuid
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Null when there is no authenticated actor (e.g. failed login).
  actorTenantUserId String?     @db.Uuid
  /// Composite FK guarantees the actor belongs to the same tenant.
  actor             TenantUser? @relation(fields: [tenantId, actorTenantUserId], references: [tenantId, id], onDelete: Restrict)
  /// Code-defined TenantAuditAction value.
  action            String
  targetType        String?
  targetId          String?
  /// Branch the action happened in / concerns, when there is one.
  branchId          String?     @db.Uuid
  branch            Branch?     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  /// Changed fields / context only. Never secrets or password material.
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, actorTenantUserId, createdAt])
  @@index([tenantId, targetType, targetId, createdAt])
  @@map("tenant_audit_logs")
}
