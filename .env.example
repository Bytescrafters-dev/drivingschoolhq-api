DATABASE_URL="postgresql://postgres:postgres@localhost:5433/drivingschoolhq?schema=public"
PORT=3000

# Bootstrap platform super admin (used by `npm run prisma:seed`).
# The password is temporary: the admin is forced to change it on first login.
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_NAME="Platform Super Admin"
SEED_SUPER_ADMIN_PASSWORD="change-me-to-a-strong-temp-password"

# Platform admin authentication
# Generate with: openssl rand -base64 48  (min 32 chars, keep secret)
PLATFORM_JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
PLATFORM_ACCESS_TOKEN_TTL_SECONDS=900
PLATFORM_REFRESH_TOKEN_TTL_DAYS=7
# Rate limit for /platform/auth/login and /refresh (requests per window per IP)
PLATFORM_AUTH_RATE_LIMIT=5
PLATFORM_AUTH_RATE_WINDOW_SECONDS=60
